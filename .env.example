# Copy to ignored .env.local. Use a separate database for previews/development.
# Local only: file:./.local/attendance.db; production requires a hosted database.
TURSO_DATABASE_URL="file:./.local/attendance.db"
TURSO_AUTH_TOKEN=""
SETUP_TOKEN="generate-a-long-random-setup-token"
DEMO_PASSWORD="choose-a-demo-password-of-at-least-10-characters"
DEMO_READER_TOKEN="generate-64-lowercase-hex-characters"
